{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/main.ts", "src/App.vue", "src/modern/**/*.ts", "src/modern/**/*.vue"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "references": [{ "path": "./tsconfig.vite-config.json" }]
}
